# ---------- Sesión ----------
NEXTAUTH_URL=https://actas.geovictoria.com      # URL pública donde quedará la app
NEXTAUTH_SECRET=                                # openssl rand -base64 32

# Dominios autorizados para entrar (separados por coma)
ALLOWED_EMAIL_DOMAINS=geovictoria.com,geo-victoria.com

# ---------- Inicio de sesión ----------
# Por defecto: se entra escribiendo el correo @geovictoria.com (sin verificación).
# ACCESS_KEY: opcional, una clave del equipo que además se pide al entrar.
# LOGIN_MODE=code: opcional, envía un código de 6 dígitos al correo (requiere SMTP_USER y SMTP_PASS).
LOGIN_MODE=email
ACCESS_KEY=

# Solo si LOGIN_MODE=code. Con Gmail: verificación en 2 pasos + "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=                                      # ej. actas.geovictoria@gmail.com
SMTP_PASS=                                      # contraseña de aplicación de 16 letras (sin espacios)
MAIL_FROM=                                      # opcional, ej. Generador de actas GeoVictoria <actas.geovictoria@gmail.com>

# ---------- (Opcional) Inicio de sesión con Microsoft (Entra ID) ----------
# Redirect URI a registrar: {NEXTAUTH_URL}/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=                             # id del tenant de GeoVictoria → solo cuentas de la empresa

# (Alternativo) Google Workspace. Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Solo para probar en un computador local, sin Microsoft. Se ignora en producción.
DEV_LOGIN=false

# ---------- IA (Anthropic) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ACTA_TIMEZONE=America/Bogota                    # para la fecha del acta y resolver "el martes"

# ---------- Samu.ai (API REST, plan Enterprise) ----------
SAMU_API_BASE_URL=https://api.samu.ai
SAMU_API_KEY=
SAMU_RECENT_DAYS=30
SAMU_MOCK=false                                 # true = reuniones de ejemplo, sin llamar a Samu
# Rutas y nombres de parámetros: confirmar en https://api.samu.ai/docs y ajustar si difieren
SAMU_PATH_MEETINGS=/v1/meetings
SAMU_PATH_TRANSCRIPT=/v1/meetings/{id}/transcription
SAMU_PARAM_EMAIL=attendeeEmails
SAMU_PARAM_FROM=from
SAMU_PARAM_TO=to
SAMU_PARAM_LIMIT=limit
SAMU_PARAM_OFFSET=offset

# ---------- Zoho CRM ----------
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_API_VERSION=v8
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=     # scopes: ZohoCRM.modules.tasks.CREATE,ZohoCRM.modules.tasks.READ,ZohoCRM.modules.accounts.READ,ZohoCRM.users.READ
ZOHO_DRY_RUN=false      # true = arma la matriz de tareas pero no crea nada en Zoho
